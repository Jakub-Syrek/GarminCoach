<Window x:Class="GarminCoach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GarminCoach.Views"
        Title="GarminCoach" Height="820" Width="1400"
        Background="#FFFAFAFB"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF1F2329" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="GarminCoach" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Dashboard + AI coach" Foreground="#FFA0A0A8" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Ustawienia" Padding="12,4"
                        Click="OnSettingsClick"
                        Background="#FF2F343C" Foreground="White" BorderBrush="#FF3F454F"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="500"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <views:DashboardView Grid.Column="0" DataContext="{Binding Dashboard}"/>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#FFE5E5E8"/>
            <views:ChatView Grid.Column="2" DataContext="{Binding Chat}"/>
        </Grid>
    </DockPanel>
</Window>
