<UserControl x:Class="GarminCoach.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource Bg0}">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Border0}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard" Style="{StaticResource TitleLarge}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{StaticResource Ok}"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource LabelSmall}"
                                           Foreground="{StaticResource TextMd}"/>
                            </StackPanel>
                        </Border>

                        <!-- Brand badges: data sources -->
                        <TextBlock Text="Połączone z" Margin="14,0,8,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMute}" FontSize="11"/>

                        <!-- Garmin Connect badge -->
                        <Border Background="#FF0079C1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0"
                                ToolTip="Źródło danych biometrycznych: Garmin Connect">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Fill="White"
                                          Stretch="Uniform"
                                          Data="M 50,0 L 100,86.6 L 0,86.6 Z"/>
                                    <TextBlock Text="G" Foreground="#FF0079C1" FontWeight="Bold"
                                               FontSize="9" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="0,2,0,0"/>
                                </Grid>
                                <TextBlock Text="GARMIN" Foreground="White" FontSize="10.5"
                                           FontWeight="Bold" VerticalAlignment="Center"
                                           Padding="0,0,0,1"/>
                            </StackPanel>
                        </Border>

                        <!-- Anthropic Claude badge -->
                        <Border Background="#FFCC785C" CornerRadius="6" Padding="8,3"
                                ToolTip="Analiza: Anthropic Claude">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Fill="White" Stretch="Uniform"
                                      Data="M 50,0 L 60,40 L 100,50 L 60,60 L 50,100 L 40,60 L 0,50 L 40,40 Z"/>
                                <TextBlock Text="Claude" Foreground="White" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}"
                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Odśwież" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Command="{Binding GenerateReportCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}"
                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Generuj raport" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,16">
            <StackPanel>

                <!-- KPI row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource MetricCard}" Grid.Column="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource CatRunning}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="KROKI" Style="{StaticResource LabelMicro}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StepsToday}" Style="{StaticResource ValueLarge}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}" Grid.Column="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource Danger}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="RESTING HR" Style="{StaticResource LabelMicro}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RestingHr}" Style="{StaticResource ValueLarge}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}" Grid.Column="2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource CatClimbing}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="SEN" Style="{StaticResource LabelMicro}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SleepLast}" Style="{StaticResource ValueLarge}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}" Grid.Column="3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE83E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource Ok}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="BODY BATTERY" Style="{StaticResource LabelMicro}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BodyBattery}" Style="{StaticResource ValueLarge}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}" Grid.Column="4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource CatCycling}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="HRV" Style="{StaticResource LabelMicro}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HrvLast}" Style="{StaticResource ValueMedium}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCard}" Grid.Column="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9A9;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource Warn}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="STRES" Style="{StaticResource LabelMicro}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StressLast}" Style="{StaticResource ValueLarge}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Coach report (sticky if present) -->
                <Border Style="{StaticResource Card}" Margin="6,12,6,0"
                        Visibility="{Binding ReportText, Converter={StaticResource StringToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource AccentBg}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}"
                                       Foreground="White" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="RAPORT COACHA" Style="{StaticResource LabelMicro}"
                                       Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="{Binding ReportText}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextHi}" FontSize="13"
                                       LineHeight="20" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="TĘTNO I STRES" Style="{StaticResource SectionHeader}"/>
                <Grid Height="180">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Grid.Column="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Resting HR" Style="{StaticResource LabelSmall}"
                                       Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding HrSeries}" XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxesHr}" LegendPosition="Hidden"
                                                Background="Transparent"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Stres dzienny (avg)" Style="{StaticResource LabelSmall}"
                                       Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding StressSeries}" XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxesStress}" LegendPosition="Hidden"
                                                Background="Transparent"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <TextBlock Text="SEN I REGENERACJA" Style="{StaticResource SectionHeader}"/>
                <Grid Height="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Grid.Column="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Fazy snu (h)" Style="{StaticResource LabelSmall}"
                                       Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding SleepStagesSeries}" XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxesSleep}" LegendPosition="Bottom"
                                                Background="Transparent"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="HRV overnight (ms)" Style="{StaticResource LabelSmall}"
                                       Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding HrvSeries}" XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxesHrv}" LegendPosition="Hidden"
                                                Background="Transparent"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <TextBlock Text="ENERGIA I WOLUMEN TRENINGOWY" Style="{StaticResource SectionHeader}"/>
                <Grid Height="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Grid.Column="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Body Battery: naładowane / zużyte"
                                       Style="{StaticResource LabelSmall}" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding BodyBatterySeries}" XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxesBB}" LegendPosition="Bottom"
                                                Background="Transparent"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Minuty treningu wg dyscypliny"
                                       Style="{StaticResource LabelSmall}" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding ActivityVolumeSeries}" XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxesVolume}" LegendPosition="Bottom"
                                                Background="Transparent"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <TextBlock Text="PODSUMOWANIE WG DYSCYPLINY" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <DataGrid Style="{StaticResource DarkDataGrid}"
                              ItemsSource="{Binding CategoryAggregates}"
                              AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KATEGORIA" Width="150" Binding="{Binding Category}"/>
                            <DataGridTextColumn Header="SESJI" Width="60" Binding="{Binding SessionCount}"/>
                            <DataGridTextColumn Header="CZAS" Width="100"
                                                Binding="{Binding TotalDuration, StringFormat='{}{0:h\\:mm\\:ss}'}"/>
                            <DataGridTextColumn Header="DYST. [km]" Width="100"
                                                Binding="{Binding TotalDistanceMeters, StringFormat='{}{0:F1}'}"/>
                            <DataGridTextColumn Header="D+ [m]" Width="80"
                                                Binding="{Binding TotalElevationGainMeters, StringFormat='{}{0:F0}'}"/>
                            <DataGridTextColumn Header="AVG HR" Width="70"
                                                Binding="{Binding AverageHr, StringFormat='{}{0:F0}'}"/>
                            <DataGridTextColumn Header="KCAL" Width="80"
                                                Binding="{Binding TotalCalories, StringFormat='{}{0:F0}'}"/>
                            <DataGridTextColumn Header="TSS" Width="*"
                                                Binding="{Binding TotalTrainingLoad, StringFormat='{}{0:F0}'}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Text="AKTYWNOŚCI" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <DataGrid Style="{StaticResource DarkDataGrid}"
                              ItemsSource="{Binding Activities}"
                              AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATA" Binding="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="TYP" Binding="{Binding ActivityType}" Width="150"/>
                            <DataGridTextColumn Header="NAZWA" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="CZAS" Binding="{Binding Duration, StringFormat='{}{0:hh\\:mm\\:ss}'}" Width="80"/>
                            <DataGridTextColumn Header="DYST. [m]" Binding="{Binding DistanceMeters, StringFormat='{}{0:F0}'}" Width="90"/>
                            <DataGridTextColumn Header="D+ [m]" Binding="{Binding ElevationGainMeters, StringFormat='{}{0:F0}'}" Width="80"/>
                            <DataGridTextColumn Header="AVG HR" Binding="{Binding AverageHr, StringFormat='{}{0:F0}'}" Width="70"/>
                            <DataGridTextColumn Header="KCAL" Binding="{Binding Calories, StringFormat='{}{0:F0}'}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
