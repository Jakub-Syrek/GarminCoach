<UserControl x:Class="GarminCoach.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFAFAFB">
    <UserControl.Resources>
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#FFCC785A"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="60,4,8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>
        <Style x:Key="AssistantBubble" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="8,4,60,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="BorderBrush" Value="#FFE5E5E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFE5E5E8" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Coach AI" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#FF6B6B70"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE5E5E8" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="40" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8,6"
                         KeyDown="OnInputKeyDown"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                <Button Grid.Column="1" Content="Wyślij" Margin="8,0,0,0" Padding="14,4"
                        Command="{Binding SendCommand}"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="6">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource UserBubble}">
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White"/>
                            </Border>
                            <Border Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource AssistantBubble}">
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
