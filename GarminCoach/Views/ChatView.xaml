<UserControl x:Class="GarminCoach.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg0}">
    <UserControl.Resources>
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentBg}"/>
            <Setter Property="CornerRadius" Value="14,14,4,14"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="50,4,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="380"/>
        </Style>
        <Style x:Key="AssistantBubble" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border0}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14,14,14,4"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,4,50,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="380"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Border0}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBg}">
                        <TextBlock Text="&#xE99A;" FontFamily="{StaticResource IconFont}"
                                   Foreground="White" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Coach AI" Style="{StaticResource ValueMedium}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource LabelSmall}"
                                   Foreground="{StaticResource TextLo}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Input -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Border0}" BorderThickness="0,1,0,0"
                Padding="14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="44" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="OnInputKeyDown"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                            Padding="14,10" Command="{Binding SendCommand}">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                </Grid>
                <TextBlock Text="Ctrl+Enter — wyślij" Foreground="{StaticResource TextMute}" FontSize="10.5"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="14,8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource UserBubble}">
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               Foreground="White" FontSize="13" LineHeight="19"/>
                                </Border>
                                <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}"
                                            Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="{StaticResource AccentBg}" VerticalAlignment="Top" Margin="0,4,0,0">
                                        <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Style="{StaticResource AssistantBubble}" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextHi}" FontSize="13"
                                                   LineHeight="19"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●●●" Foreground="{StaticResource Accent}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Coach pisze…" Margin="8,0,0,0" Style="{StaticResource LabelSmall}"
                                   Foreground="{StaticResource TextMd}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
