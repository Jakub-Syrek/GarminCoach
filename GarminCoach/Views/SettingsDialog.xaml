<Window x:Class="GarminCoach.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia GarminCoach"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F7F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Konfiguracja połączeń" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF555555"
                       Text="Dane logowania są szyfrowane przez Windows DPAPI i przechowywane lokalnie w %AppData%\GarminCoach."/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Email Garmin Connect" Margin="0,8,0,4"/>
            <TextBox Text="{Binding GarminEmail, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

            <TextBlock Text="Hasło Garmin Connect" Margin="0,8,0,4"/>
            <PasswordBox x:Name="PasswordBoxControl" Padding="6,4" PasswordChanged="OnPasswordChanged"/>

            <TextBlock Text="Klucz Anthropic API (sk-ant-...)" Margin="0,8,0,4"/>
            <TextBox Text="{Binding AnthropicApiKey, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Model Claude"/>
                    <ComboBox Margin="0,4,0,0"
                              SelectedValue="{Binding Model}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="claude-haiku-4-5-20251001"/>
                        <ComboBoxItem Content="claude-sonnet-4-6"/>
                        <ComboBoxItem Content="claude-opus-4-7"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Liczba dni do pobrania"/>
                    <TextBox Text="{Binding DaysToFetch}" Margin="0,4,0,0" Padding="6,4"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="Zapisano." Foreground="Green" VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="{Binding Saved, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Zapisz" Width="100" Padding="8,4" Command="{Binding SaveCommand}"
                    Click="OnSaveClick"/>
            <Button Content="Zamknij" Width="100" Padding="8,4" Margin="8,0,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
