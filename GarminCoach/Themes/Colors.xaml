<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surface scale (dark) -->
    <Color x:Key="Bg0Color">#FF0A0E14</Color>
    <Color x:Key="Bg1Color">#FF0D1117</Color>
    <Color x:Key="Bg2Color">#FF161B22</Color>
    <Color x:Key="Bg3Color">#FF1C232D</Color>
    <Color x:Key="Bg4Color">#FF22293382</Color>
    <Color x:Key="BorderColor">#FF21262D</Color>
    <Color x:Key="BorderStrongColor">#FF30363D</Color>

    <!-- Text scale -->
    <Color x:Key="TextHiColor">#FFE6EDF3</Color>
    <Color x:Key="TextMdColor">#FFB6BEC7</Color>
    <Color x:Key="TextLoColor">#FF7D8590</Color>
    <Color x:Key="TextMuteColor">#FF484F58</Color>

    <!-- Brand accent (Garmin orange family) -->
    <Color x:Key="AccentColor">#FFFF6B35</Color>
    <Color x:Key="AccentHoverColor">#FFFF7F4D</Color>
    <Color x:Key="AccentPressColor">#FFE85A29</Color>

    <!-- Semantic -->
    <Color x:Key="OkColor">#FF3FB950</Color>
    <Color x:Key="WarnColor">#FFD29922</Color>
    <Color x:Key="DangerColor">#FFF85149</Color>

    <!-- Activity palette -->
    <Color x:Key="CatRunningColor">#FFFF6B35</Color>
    <Color x:Key="CatCyclingColor">#FF58A6FF</Color>
    <Color x:Key="CatGymColor">#FFFFB454</Color>
    <Color x:Key="CatClimbingColor">#FFBC8CFF</Color>
    <Color x:Key="CatMountainColor">#FF3FB950</Color>
    <Color x:Key="CatSwimmingColor">#FF39C5CF</Color>
    <Color x:Key="CatWalkingColor">#FF7D8590</Color>
    <Color x:Key="CatOtherColor">#FF9CA3AF</Color>

    <SolidColorBrush x:Key="CatRunning"  Color="{StaticResource CatRunningColor}"/>
    <SolidColorBrush x:Key="CatCycling"  Color="{StaticResource CatCyclingColor}"/>
    <SolidColorBrush x:Key="CatGym"      Color="{StaticResource CatGymColor}"/>
    <SolidColorBrush x:Key="CatClimbing" Color="{StaticResource CatClimbingColor}"/>
    <SolidColorBrush x:Key="CatMountain" Color="{StaticResource CatMountainColor}"/>
    <SolidColorBrush x:Key="CatSwimming" Color="{StaticResource CatSwimmingColor}"/>
    <SolidColorBrush x:Key="CatWalking"  Color="{StaticResource CatWalkingColor}"/>
    <SolidColorBrush x:Key="CatOther"    Color="{StaticResource CatOtherColor}"/>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}"/>
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}"/>
    <SolidColorBrush x:Key="Border0" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextHi" Color="{StaticResource TextHiColor}"/>
    <SolidColorBrush x:Key="TextMd" Color="{StaticResource TextMdColor}"/>
    <SolidColorBrush x:Key="TextLo" Color="{StaticResource TextLoColor}"/>
    <SolidColorBrush x:Key="TextMute" Color="{StaticResource TextMuteColor}"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPress" Color="{StaticResource AccentPressColor}"/>

    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>

    <!-- Card gradient (subtle elevation) -->
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF181F28" Offset="0"/>
        <GradientStop Color="#FF131922" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0F1419" Offset="0"/>
        <GradientStop Color="#FF0A0E14" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentBg" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF6B35" Offset="0"/>
        <GradientStop Color="#FFFF8A4D" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
